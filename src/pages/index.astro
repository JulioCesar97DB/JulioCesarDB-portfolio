---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import Hero from "@/components/Hero.astro";
import ParticleBackground from "@/components/ParticleBackground.astro";
import Work from "@/components/sections/Work.astro";
import Experience from "@/components/sections/Experience.astro";
import Skills from "@/components/sections/Skills.astro";
import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";
import { basics } from "@cv";

const { name } = basics;
const year = new Date().getFullYear();
---

<Layout>
  <TopBar />
  <main id="main-content">
    <!-- Particle fields: one across the hero and Selected work (ending where
         Experience begins), one behind Skills and About, between the two
         tinted bands. -->
    <div class="relative" data-bg-region>
      <ParticleBackground />
      <Hero />
      <Work />
    </div>
    <Experience />
    <div class="relative" data-bg-region>
      <ParticleBackground fade="both" />
      <Skills />
      <About />
    </div>
    <Contact />
  </main>
  <footer class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-8 text-sm text-ink-3 sm:flex-row sm:justify-between">
      <p>© {year} {name}</p>
      <p>
        Built with Astro and Tailwind CSS.{" "}
        <a
          href="https://github.com/JulioCesar97DB/JulioCesarDB-portfolio"
          target="_blank"
          rel="noopener noreferrer"
          class="link -my-3 inline-block py-3"
        >
          Source<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  </footer>
</Layout>

<script>
  import { initInteractions } from "@/scripts/interactions";
  import { initTheme } from "@/scripts/theme";
  initTheme();
  initInteractions();
</script>
