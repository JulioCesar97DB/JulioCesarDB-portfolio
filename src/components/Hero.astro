---
import EmailActions from "@/components/EmailActions.astro";
import Icon from "@/icons/Icon.astro";
import type { CV } from "@/cv";
import { basics as rawBasics, work as rawWork } from "@cv";

const basics = rawBasics as CV["basics"];
const work = rawWork as CV["work"];

const { name, label, tagline, location, resume, profiles } = basics;

const firstYear = Math.min(...work.map((job) => new Date(job.startDate).getUTCFullYear()));
const links = profiles.filter((p) => p.network === "GitHub" || p.network === "LinkedIn");
---

<!-- No isolation or z-index here on purpose: the name must be able to render
     above the fixed top bar while it flies into it. -->
<section id="top" class="relative">
  <div class="container-page pt-32 pb-16 sm:pt-40 lg:pt-48 lg:pb-24">
  <h1 class="hero-name" data-hero-name>{name}</h1>

  <p class="mt-6 max-w-[34ch] text-lead text-ink sm:mt-8">
    <span class="font-semibold">{label}.</span>{" "}
    <span class="text-ink-2">{tagline}</span>
  </p>

  <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem] text-ink-3">
    <li>{location.city}, {location.region}</li>
    <li>English &amp; Spanish</li>
    <li>Shipping since <span class="tabular">{firstYear}</span></li>
  </ul>

  <div class="mt-10 flex flex-wrap items-center gap-3">
    {
      resume && (
        <a href={resume} class="btn btn-primary" download>
          <Icon name="file" class="size-4" />
          Résumé
        </a>
      )
    }
    <EmailActions />
    <div class="flex items-center">
      {
        links.map((profile) => (
          <a
            href={profile.url}
            class="icon-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${profile.network} (opens in a new tab)`}
          >
            <Icon name={profile.network === "GitHub" ? "github" : "linkedin"} class="size-[1.15rem]" />
          </a>
        ))
      }
    </div>
  </div>
  </div>
</section>

<style>
  .hero-name {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 640;
    font-stretch: 118%;
    letter-spacing: -0.04em;
    color: var(--ink);
    /* Keep "Julio César" and "Díaz" from splitting awkwardly on phones. */
    text-wrap: balance;
  }
</style>
