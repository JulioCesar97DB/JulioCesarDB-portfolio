---
import Icon from "@/icons/Icon.astro";
import ThemeMenu from "@/components/ThemeMenu.astro";
import { basics } from "@cv";

const { name, resume } = basics;

const navItems = [
  { id: "work", label: "Work" },
  { id: "experience", label: "Experience" },
  { id: "about", label: "About" },
];
---

<!-- At the top of the page the bar is invisible chrome spanning the layout.
     Once the page scrolls (data-scrolled) it contracts into a floating glass
     pill; the wordmark joins it when the hero name leaves (data-named).
     scripts/interactions.ts toggles both attributes. -->
<header class="topbar fixed inset-x-0 top-0 z-40 px-2 sm:px-4" data-topbar>
  <div class="bar mx-auto flex items-center gap-1">
    <a
      href="#top"
      class="wordmark flex min-h-11 items-center rounded-full px-2 font-semibold tracking-tight whitespace-nowrap text-ink"
      aria-label={`${name}, back to top`}
    >
      <span class="wordmark-text hidden sm:inline" data-wordmark-full>{name}</span>
      <span class="sm:hidden">JCD</span>
    </a>

    <nav class="ml-auto" aria-label="Sections">
      <ul class="flex items-center">
        {
          navItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-nav-link
                class="nav-link flex min-h-11 items-center rounded-full px-2.5 text-[0.9375rem] text-ink-3 transition-colors hover:text-ink sm:px-3"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeMenu />

    {
      resume && (
        <a
          href={resume}
          class="btn resume-btn ml-0.5 min-h-10 w-10 justify-center rounded-full px-0 text-sm sm:w-auto sm:px-3.5"
          aria-label="Download résumé (PDF)"
          download
        >
          <span class="hidden sm:inline">Résumé</span>
          <Icon name="arrow-down" class="size-4 text-ink-3 sm:size-3.5" />
        </a>
      )
    }
  </div>
</header>

<style>
  .bar {
    position: relative;
    max-width: var(--container-page);
    height: 4rem;
    margin-top: 0;
    padding-inline: clamp(0.75rem, 4vw, 2.5rem);
    border: 1px solid transparent;
    border-radius: 1.75rem;
    background: transparent;
    transition:
      max-width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      margin-top 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  /* The glass: translucent fill over a heavy blur with saturation, a bright rim
     where light catches the top edge, a faint specular sheen across the upper
     half, and a soft drop shadow to lift it off the page. */
  .topbar[data-scrolled] .bar {
    max-width: 46rem;
    height: 3.25rem;
    margin-top: 0.75rem;
    padding-inline: 0.375rem;
    border-color: var(--glass-edge);
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    backdrop-filter: blur(20px) saturate(1.8);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      inset 0 -1px 0 var(--glass-edge),
      0 10px 30px -10px var(--shade-3),
      0 2px 6px -2px var(--shade-2);
  }
  .bar::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to bottom,
      light-dark(oklch(1 0 0 / 0.45), oklch(1 0 0 / 0.06)),
      transparent 55%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .topbar[data-scrolled] .bar::before {
    opacity: 1;
  }
  .bar > * {
    position: relative;
  }

  .topbar[data-scrolled] .resume-btn {
    border-color: transparent;
    background: var(--ink);
    color: var(--bg);
  }
  .topbar[data-scrolled] .resume-btn :global(svg) {
    color: inherit;
  }

  /* Without backdrop-filter the glass would be see-through; go nearly opaque. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .topbar[data-scrolled] .bar {
      background: var(--raised);
    }
  }

  .wordmark {
    max-width: 0;
    overflow: hidden;
    padding-inline: 0;
    opacity: 0;
    pointer-events: none;
    transition:
      max-width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
  }
  .topbar[data-named] .wordmark,
  :global(html:not(.js)) .wordmark {
    max-width: 14rem;
    padding-inline: 0.75rem;
    opacity: 1;
    pointer-events: auto;
  }

  /* Name morph (large screens, scripts/interactions.ts adds html.name-morph):
     the hero name itself flies into this slot, so the slot opens as soon as
     the bar turns to glass and its own text only appears once the flying name
     has landed on it (data-named). */
  :global(html.name-morph) .topbar[data-scrolled] .wordmark {
    max-width: 14rem;
    padding-inline: 0.75rem;
    opacity: 1;
    pointer-events: auto;
  }
  :global(html.name-morph) .wordmark-text {
    opacity: 0;
  }
  :global(html.name-morph) .topbar[data-named] .wordmark-text {
    opacity: 1;
  }

  .nav-link[aria-current="true"] {
    color: var(--ink);
  }
</style>
