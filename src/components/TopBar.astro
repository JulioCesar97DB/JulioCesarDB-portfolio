---
import Icon from "@/icons/Icon.astro";
import ThemeMenu from "@/components/ThemeMenu.astro";
import { basics } from "@cv";

const { name, resume } = basics;

const navItems = [
  { id: "work", label: "Work" },
  { id: "experience", label: "Experience" },
  { id: "about", label: "About" },
];
---

<!-- At the top of the page the bar is invisible chrome spanning the layout.
     As the page scrolls it gradually turns to glass and contracts into a
     floating pill (scroll-linked, see the style block); the wordmark joins it
     when the hero name leaves (data-named). scripts/interactions.ts drives both. -->
<header class="topbar fixed inset-x-0 top-0 z-40 px-2 sm:px-4" data-topbar>
  <div class="bar mx-auto flex items-center gap-1">
    <a
      href="#top"
      class="wordmark flex min-h-11 items-center rounded-full px-2 font-semibold tracking-tight whitespace-nowrap text-ink"
      aria-label={`${name}, back to top`}
    >
      <span class="wordmark-text hidden sm:inline" data-wordmark-full>{name}</span>
      <span class="sm:hidden">JCD</span>
    </a>

    <nav class="ml-auto" aria-label="Sections">
      <ul class="flex items-center">
        {
          navItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-nav-link
                class="nav-link flex min-h-11 items-center rounded-full px-2.5 text-[0.9375rem] text-ink-3 transition-colors hover:text-ink sm:px-3"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeMenu />

    {
      resume && (
        <a
          href={resume}
          class="btn resume-btn ml-0.5 min-h-10 w-10 justify-center rounded-full px-0 text-sm sm:w-auto sm:px-3.5"
          aria-label="Download résumé (PDF)"
          download
        >
          <span class="hidden sm:inline">Résumé</span>
          <Icon name="arrow-down" class="size-4 text-ink-3 sm:size-3.5" />
        </a>
      )
    }
  </div>
</header>

<style>
  /* The bar's shape is driven by scroll, not toggled. scripts/interactions.ts
     writes three eased 0..1 phases on the header as the page scrolls:
       --glass   the glass material fades in (fill, blur, rim, edge, shadow)
       --shrink  the bar contracts from the layout width into the pill
       --fill    the Résumé button fills with ink
     Every property below interpolates from those, so the change is spread
     over the whole scroll range instead of firing at one threshold. */
  .topbar {
    --glass: 0;
    --shrink: 0;
    --fill: 0;
  }
  /* Without JS the bar is simply the finished pill. */
  :global(html:not(.js)) .topbar {
    --glass: 1;
    --shrink: 1;
    --fill: 1;
  }

  .bar {
    position: relative;
    width: 100%;
    max-width: calc(var(--container-page) - (var(--container-page) - 46rem) * var(--shrink));
    height: calc(4rem - 0.75rem * var(--shrink));
    margin-top: calc(0.75rem * var(--shrink));
    padding-inline: calc(
      clamp(0.75rem, 4vw, 2.5rem) - (clamp(0.75rem, 4vw, 2.5rem) - 0.375rem) * var(--shrink)
    );
    border: 1px solid color-mix(in oklch, var(--glass-edge) calc(var(--glass) * 100%), transparent);
    border-radius: 1.75rem;
    background: color-mix(in oklch, var(--glass-fill) calc(var(--glass) * 100%), transparent);
    -webkit-backdrop-filter: blur(calc(20px * var(--glass))) saturate(calc(1 + 0.8 * var(--glass)));
    backdrop-filter: blur(calc(20px * var(--glass))) saturate(calc(1 + 0.8 * var(--glass)));
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--glass-rim) calc(var(--glass) * 100%), transparent),
      inset 0 -1px 0 color-mix(in oklch, var(--glass-edge) calc(var(--glass) * 100%), transparent),
      0 calc(10px * var(--glass)) 30px -10px
        color-mix(in oklch, var(--shade-3) calc(var(--glass) * 100%), transparent),
      0 2px 6px -2px color-mix(in oklch, var(--shade-2) calc(var(--glass) * 100%), transparent);
  }
  /* A faint specular sheen across the upper half of the glass. */
  .bar::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to bottom,
      light-dark(oklch(1 0 0 / 0.45), oklch(1 0 0 / 0.06)),
      transparent 55%
    );
    opacity: var(--glass);
    pointer-events: none;
  }
  .bar > * {
    position: relative;
  }

  /* Without backdrop-filter the glass would be see-through; fill with the plate. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bar {
      background: color-mix(in oklch, var(--raised) calc(var(--glass) * 100%), transparent);
    }
  }

  .resume-btn {
    border-color: color-mix(in oklch, var(--line-strong) calc((1 - var(--fill)) * 100%), transparent);
    background: color-mix(in oklch, var(--ink) calc(var(--fill) * 100%), var(--raised));
    color: color-mix(in oklch, var(--bg) calc(var(--fill) * 100%), var(--ink));
  }
  .resume-btn :global(svg) {
    color: inherit;
  }

  /* Wordmark, small screens: fades in once the hero name has scrolled away. */
  .wordmark {
    max-width: 0;
    overflow: hidden;
    padding-inline: 0;
    opacity: 0;
    pointer-events: none;
    transition:
      max-width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
  }
  .topbar[data-named] .wordmark,
  :global(html:not(.js)) .wordmark {
    max-width: 14rem;
    padding-inline: 0.75rem;
    opacity: 1;
    pointer-events: auto;
  }

  /* Name morph (large screens, html.name-morph): the hero name itself flies
     into this slot. The slot is open from the start so the landing name is
     never clipped; its own text appears only once the name has landed on it
     (data-named). */
  :global(html.name-morph) .wordmark {
    max-width: 14rem;
    padding-inline: 0.75rem;
    opacity: 1;
    transition: none;
  }
  :global(html.name-morph) .topbar[data-named] .wordmark {
    pointer-events: auto;
  }
  :global(html.name-morph) .wordmark-text {
    opacity: 0;
  }
  :global(html.name-morph) .topbar[data-named] .wordmark-text {
    opacity: 1;
  }

  .nav-link[aria-current="true"] {
    color: var(--ink);
  }
</style>
