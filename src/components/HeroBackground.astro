---
// Decorative background for the hero and Selected work. The layer spans the
// whole region, but the canvas inside is only one viewport tall and sticky, so
// it stays behind whatever is on screen and leaves with the region at
// Experience. Rendering cost is one screen, not the region's full height.
---

<div class="bg-layer" aria-hidden="true">
  <canvas class="bg-canvas" data-hero-bg></canvas>
</div>

<script>
  import { initHeroBackground } from "@/scripts/hero-bg";
  initHeroBackground();
</script>

<style>
  /* z-index -1 in the root stacking context: behind the content, above the
     page background, without isolating the hero (the name must fly above the
     top bar). The bottom edge fades so the field hands over softly to the
     Experience band. */
  .bg-layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 14rem), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 14rem), transparent);
  }
  .bg-canvas {
    position: sticky;
    top: 0;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100lvh;
  }
</style>
