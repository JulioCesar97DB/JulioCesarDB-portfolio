---
import Icon from "@/icons/Icon.astro";
import { basics } from "@cv";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { email } = basics;
---

<!-- The address is visible text and a mailto link, so it works without a mail
     client or JavaScript; the copy button is an enhancement on top. -->
<div class:list={["inline-flex items-center", className]} data-copy-root>
  <a href={`mailto:${email}`} class="btn rounded-r-none pr-3.5">
    <Icon name="mail" class="size-4 text-ink-3" />
    <span>{email}</span>
  </a>
  <button
    type="button"
    class="btn -ml-px w-11 justify-center rounded-l-none px-0 text-ink-3 hover:text-ink"
    data-copy-email={email}
    aria-label="Copy email address"
  >
    <span class="copy-idle"><Icon name="copy" class="size-4" /></span>
    <span class="copy-done hidden text-accent"><Icon name="check" class="size-4" /></span>
  </button>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</div>
