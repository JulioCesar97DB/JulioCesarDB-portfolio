---
// Decorative particle field for a page region. Place it as the first child of
// a `relative` element marked `data-bg-region`. The layer spans the whole
// region, but the canvas inside is only one viewport tall and sticky, so it
// stays behind whatever is on screen and leaves with the region: the
// rendering cost is one screen, not the region's full height. The particles
// inside still travel with the scroll, as parallax (see particles/runtime).
interface Props {
  /** Which edges fade into the page: the hero only fades at the bottom; a
      region between two bands fades at both. */
  fade?: "bottom" | "both";
}

const { fade = "bottom" } = Astro.props;
---

<div class:list={["bg-layer", `fade-${fade}`]} aria-hidden="true">
  <canvas class="bg-canvas" data-particles></canvas>
</div>

<script>
  import { initParticleBackgrounds } from "@/scripts/particles";
  initParticleBackgrounds();
</script>

<style>
  /* z-index -1 in the root stacking context: behind the content, above the
     page background, without isolating the region (the hero name must fly
     above the top bar). */
  .bg-layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .fade-bottom {
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 14rem), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 14rem), transparent);
  }
  .fade-both {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 10rem,
      #000 calc(100% - 10rem),
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 10rem,
      #000 calc(100% - 10rem),
      transparent
    );
  }
  .bg-canvas {
    position: sticky;
    top: 0;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100lvh;
  }
</style>
