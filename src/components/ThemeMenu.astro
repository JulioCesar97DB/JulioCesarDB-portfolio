---
import Icon from "@/icons/Icon.astro";

const options = [
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" },
  { value: "system", label: "System", icon: "monitor" },
] as const;
---

<!-- Native Popover API: open/close, Escape and light-dismiss come from the
     browser. scripts/theme.ts only applies and remembers the choice. -->
<div class="theme-menu relative">
  <button
    type="button"
    class="icon-btn flex-none"
    popovertarget="theme-popover"
    aria-label="Color theme"
    data-theme-trigger
    data-glass-target
  >
    <span data-theme-icon="light" class="hidden"><Icon name="sun" class="size-[1.05rem]" /></span>
    <span data-theme-icon="dark" class="hidden"><Icon name="moon" class="size-[1.05rem]" /></span>
    <span data-theme-icon="system"><Icon name="monitor" class="size-[1.05rem]" /></span>
  </button>

  <div id="theme-popover" popover class="theme-popover" role="menu" aria-label="Color theme">
    {
      options.map((o) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked={o.value === "system" ? "true" : "false"}
          data-theme-option={o.value}
          class="theme-option"
        >
          <Icon name={o.icon} class="size-4" />
          <span>{o.label}</span>
          <Icon name="check" class="theme-check ml-auto size-4" />
        </button>
      ))
    }
  </div>
</div>

<style>
  .theme-popover {
    /* Anchored under the trigger where CSS anchor positioning exists; the
       fallback pins it under the top-right of the bar. */
    position: fixed;
    inset: auto;
    top: 4.25rem;
    right: max(1rem, calc((100vw - var(--container-page)) / 2 + 1rem));
    margin: 0;
    width: 11rem;
    border-radius: 1.125rem;
    border: 1px solid var(--glass-edge);
    background-color: var(--glass-fill);
    background-image: linear-gradient(to bottom, var(--glass-sheen), transparent 40%);
    background-origin: border-box;
    -webkit-backdrop-filter: blur(24px) saturate(1.9);
    backdrop-filter: blur(24px) saturate(1.9);
    box-shadow:
      var(--glass-bevel),
      0 2px 4px -2px var(--glass-drop),
      0 1.25rem 2.5rem -0.875rem var(--glass-drop);
    padding: 0.3rem;
    color: var(--ink);
    opacity: 0;
    translate: 0 -0.25rem;
    scale: 0.98;
    transform-origin: top right;
    transition:
      opacity 0.18s ease,
      translate 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      scale 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }
  /* The menu is a child of the bar, which may have flipped its scheme to
     suit what is behind it; the menu is too large to flip and keeps the
     page's own. */
  .theme-popover {
    color-scheme: light dark;
  }
  :global(:root[data-theme="light"]) .theme-popover {
    color-scheme: light;
  }
  :global(:root[data-theme="dark"]) .theme-popover {
    color-scheme: dark;
  }
  /* Hidden unless the browser opens it as a popover. Browsers without the
     Popover API (Safari before 17) never match :popover-open, so the menu
     stays hidden there instead of rendering inline in the bar. */
  .theme-popover {
    display: none;
  }
  .theme-popover:popover-open {
    display: block;
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  @starting-style {
    .theme-popover:popover-open {
      opacity: 0;
      translate: 0 -0.25rem;
      scale: 0.98;
    }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .theme-popover {
      background-color: var(--raised);
    }
  }
  @supports (position-anchor: --a) {
    .theme-menu [data-theme-trigger] {
      anchor-name: --theme-trigger;
    }
    .theme-popover {
      position-anchor: --theme-trigger;
      top: calc(anchor(bottom) + 0.5rem);
      right: anchor(right);
    }
  }

  .theme-option {
    display: flex;
    width: 100%;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.8125rem;
    padding: 0 0.7rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-align: left;
    box-shadow:
      inset 0 1px 0 transparent,
      inset 0 0 0 1px transparent;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.25s ease;
  }
  /* The option under the pointer or the keyboard is a thin fill on the panel. */
  .theme-option:hover,
  .theme-option:focus-visible {
    background-color: var(--glass-tint);
    box-shadow:
      inset 0 1px 0 light-dark(oklch(1 0 0 / 0.75), oklch(1 0 0 / 0.14)),
      inset 0 0 0 1px light-dark(oklch(1 0 0 / 0.35), oklch(1 0 0 / 0.05));
    color: var(--ink);
    outline: none;
  }
  .theme-option[aria-checked="true"] {
    color: var(--ink);
  }
  /* The check is an Icon child component, so it needs :global to be reached. */
  .theme-option :global(.theme-check) {
    visibility: hidden;
    color: var(--accent);
  }
  .theme-option[aria-checked="true"] :global(.theme-check) {
    visibility: visible;
  }
</style>
