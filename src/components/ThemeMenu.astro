---
import Icon from "@/icons/Icon.astro";

const options = [
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" },
  { value: "system", label: "System", icon: "monitor" },
] as const;
---

<!-- Native Popover API: open/close, Escape and light-dismiss come from the
     browser. scripts/theme.ts only applies and remembers the choice. -->
<div class="theme-menu relative">
  <button
    type="button"
    class="icon-btn"
    popovertarget="theme-popover"
    aria-label="Color theme"
    data-theme-trigger
    data-glass-target
  >
    <span data-theme-icon="light" class="hidden"><Icon name="sun" class="size-[1.05rem]" /></span>
    <span data-theme-icon="dark" class="hidden"><Icon name="moon" class="size-[1.05rem]" /></span>
    <span data-theme-icon="system"><Icon name="monitor" class="size-[1.05rem]" /></span>
  </button>

  <div id="theme-popover" popover class="theme-popover" role="menu" aria-label="Color theme">
    {
      options.map((o) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked={o.value === "system" ? "true" : "false"}
          data-theme-option={o.value}
          class="theme-option"
        >
          <Icon name={o.icon} class="size-4" />
          <span>{o.label}</span>
          <Icon name="check" class="theme-check ml-auto size-4" />
        </button>
      ))
    }
  </div>
</div>

<style>
  .theme-popover {
    /* Anchored under the trigger where CSS anchor positioning exists; the
       fallback pins it under the top-right of the bar. */
    position: fixed;
    inset: auto;
    top: 4.25rem;
    right: max(1rem, calc((100vw - var(--container-page)) / 2 + 1rem));
    margin: 0;
    width: 11rem;
    border-radius: 0.875rem;
    border: 1px solid var(--glass-edge);
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    backdrop-filter: blur(24px) saturate(1.8);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      0 12px 32px -8px var(--shade-3);
    padding: 0.3rem;
    color: var(--ink);
    opacity: 0;
    translate: 0 -0.25rem;
    scale: 0.98;
    transform-origin: top right;
    transition:
      opacity 0.18s ease,
      translate 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      scale 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }
  .theme-popover:popover-open {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  @starting-style {
    .theme-popover:popover-open {
      opacity: 0;
      translate: 0 -0.25rem;
      scale: 0.98;
    }
  }
  @supports (position-anchor: --a) {
    .theme-menu [data-theme-trigger] {
      anchor-name: --theme-trigger;
    }
    .theme-popover {
      position-anchor: --theme-trigger;
      top: calc(anchor(bottom) + 0.5rem);
      right: anchor(right);
    }
  }

  .theme-option {
    display: flex;
    width: 100%;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.6rem;
    padding: 0 0.7rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-align: left;
  }
  .theme-option:hover,
  .theme-option:focus-visible {
    background: var(--accent-soft);
    color: var(--ink);
    outline: none;
  }
  .theme-option[aria-checked="true"] {
    color: var(--ink);
  }
  /* The check is an Icon child component, so it needs :global to be reached. */
  .theme-option :global(.theme-check) {
    visibility: hidden;
    color: var(--accent);
  }
  .theme-option[aria-checked="true"] :global(.theme-check) {
    visibility: visible;
  }
</style>
