---
import Section from "@/components/Section.astro";
import type { CV } from "@/cv";
import { skills } from "@cv";

type Skill = CV["skills"][number];

const groups = [
  { label: "Expert", items: (skills as Skill[]).filter((skill: Skill) => skill.level === "Expert") },
  { label: "Proficient", items: (skills as Skill[]).filter((skill: Skill) => skill.level !== "Expert") },
];
---

<Section id="skills" title="Skills & Technologies">
  {/* Plain type instead of pills; the label column lines up with the job dates. */}
  <dl class="space-y-6">
    {
      groups.map((group) => (
        <div class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-5">
          <dt class="pt-0.5 font-mono text-meta uppercase tracking-wide text-slate">
            {group.label}
          </dt>
          <dd>
            <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-card text-slate-light">
              {group.items.map((skill: Skill) => (
                <li>{skill.name}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
