---
import Icon from "@/icons/Icon.astro";
import { formatDateRange } from "@/utils/dates";

interface Props {
  name: string;
  position: string;
  url: string;
  startDate: string;
  endDate: string | null;
  summary: string;
  metric?: string;
  location?: string;
  location_type?: string;
  highlights?: string[];
  achievements?: string[];
}

const {
  name,
  position,
  url,
  startDate,
  endDate,
  summary,
  metric,
  location,
  location_type,
  highlights = [],
} = Astro.props;

const dateRange = formatDateRange(startDate, endDate);
const place = [location, location_type].filter(Boolean).join(" · ");
---

<li class="reveal border-t border-line py-8 first:border-t-0 first:pt-0 last:pb-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h3 class="text-h3 font-semibold tracking-[-0.015em]">
      {
        url ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-accent"
            aria-describedby="new-tab-hint"
          >
            {name}
            <Icon name="arrow-up-right" class="size-4 text-ink-3" />
          </a>
        ) : (
          name
        )
      }
    </h3>
    <p class="meta"><time datetime={startDate}>{dateRange}</time></p>
  </div>
  <p class="mt-1 text-[0.9375rem] font-medium text-ink">{position}</p>
  {place && <p class="mt-0.5 text-sm text-ink-3">{place}</p>}

  <p class="mt-4 max-w-[68ch]">{summary}</p>

  {metric && <p class="metric mt-4">{metric}</p>}

  {
    highlights.length > 0 && (
      <details class="group mt-4">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink-3 transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Show details</span>
          <span class="hidden group-open:inline">Hide details</span>
          <Icon
            name="chevron-down"
            class="size-4 transition-transform duration-300 group-open:rotate-180"
          />
        </summary>
        <ul class="mt-2 max-w-[60ch] space-y-2 pb-1">
          {highlights.map((item) => (
            <li class="relative pl-5 text-[0.9375rem] before:absolute before:top-[0.72em] before:left-0 before:h-px before:w-2 before:bg-line-strong">
              {item}
            </li>
          ))}
        </ul>
      </details>
    )
  }
</li>

<style>
  .metric {
    color: var(--ink);
    font-weight: 560;
  }
</style>
