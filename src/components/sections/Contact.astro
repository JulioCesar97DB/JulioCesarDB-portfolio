---
import EmailActions from "@/components/EmailActions.astro";
import Icon from "@/icons/Icon.astro";
import type { CV } from "@/cv";
import { basics as rawBasics } from "@cv";

const basics = rawBasics as CV["basics"];

const { resume, profiles } = basics;
const links = profiles.filter((p) => p.network === "GitHub" || p.network === "LinkedIn");
---

<section id="contact" class="scroll-mt-20 border-t border-line bg-surface">
  <div class="container-page py-24 lg:py-32">
    <h2 class="section-title max-w-[22ch]">Email is the best way to reach me.</h2>
    <p class="mt-4 max-w-[52ch] text-lead">
      My résumé has the full history, and most of my code lives on GitHub.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <EmailActions />
      {
        resume && (
          <a href={resume} class="btn" download>
            <Icon name="file" class="size-4 text-ink-3" />
            Résumé (PDF)
          </a>
        )
      }
      <div class="flex items-center">
        {
          links.map((profile) => (
            <a
              href={profile.url}
              class="icon-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${profile.network} (opens in a new tab)`}
            >
              <Icon name={profile.network === "GitHub" ? "github" : "linkedin"} class="size-[1.15rem]" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
