---
import type { CV } from "@/cv";
import { basics as rawBasics, education as rawEducation, languages as rawLanguages } from "@cv";

const basics = rawBasics as CV["basics"];
const education = rawEducation as CV["education"];
const languages = rawLanguages as CV["languages"];

const { aboutParagraphs = [], summary } = basics;
const paragraphs = aboutParagraphs.length > 0 ? aboutParagraphs : [summary];
const degree = education[0];
const years = degree
  ? `${new Date(degree.startDate).getUTCFullYear()}–${new Date(degree.endDate).getUTCFullYear()}`
  : "";
const langs = [...languages]
  .sort((a) => (a.language === "Spanish" ? -1 : 1))
  .map((l) => `${l.language} (${l.language === "Spanish" ? "native" : "professional"})`)
  .join(", ");
---

<section id="about" class="container-page scroll-mt-20 py-24 lg:py-32">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 [&>*]:min-w-0">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <h2 class="section-title">About</h2>
          <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-1">
            <div>
              <dt class="text-sm text-ink-3">Languages</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-ink">{langs}</dd>
            </div>
            {
              degree && (
                <div>
                  <dt class="text-sm text-ink-3">Education</dt>
                  <dd class="mt-1.5 text-[0.9375rem] text-ink">
                    B.Sc. {degree.area}, UCLV
                    <span class="block text-sm text-ink-3">
                      Santa Clara, Cuba · <span class="tabular">{years}</span>
                    </span>
                  </dd>
                </div>
              )
            }
          </dl>
      </div>
    </div>

    <div class="lg:col-span-8">
      <div class="max-w-[64ch] space-y-5">
        {
          paragraphs.map((p, i) => (
            <p class:list={[i === 0 && "text-[1.125rem] leading-relaxed text-ink"]}>{p}</p>
          ))
        }
      </div>

    </div>
  </div>
</section>
