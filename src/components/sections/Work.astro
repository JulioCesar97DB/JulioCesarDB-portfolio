---
import Icon from "@/icons/Icon.astro";
import type { CV } from "@/cv";
import { projects } from "@cv";
import { projectAnchor } from "@/utils/anchors";

type Project = CV["projects"][number];

const all = projects as Project[];
const lead = all.find((p) => p.tier === "lead");
const features = all.filter((p) => p.tier === "feature");
const arch = lead?.architecture;

const host = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<section id="work" class="container-page scroll-mt-20 pb-24 lg:pb-32">
  <h2 class="section-title">Selected work</h2>

  {
    lead && (
      <article
        id={projectAnchor(lead.title ?? lead.name)}
        class="mt-10 grid scroll-mt-24 gap-8 lg:mt-14 lg:grid-cols-12 lg:items-start lg:gap-x-12 lg:gap-y-10 [&>*]:min-w-0"
      >
        <div class="lead-stage lg:col-span-7">
        <a
          href={lead.url}
          target="_blank"
          rel="noopener noreferrer"
          class="lead-rise block rounded-2xl"
          tabindex="-1"
          aria-hidden="true"
          data-frame
        >
          <div class="frame">
            <img
              src={lead.image}
              alt={lead.imageAlt ?? `${lead.title} screenshot`}
              width="900"
              height="532"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </a>
        </div>

        <div class="reveal lg:col-span-5 lg:row-span-2">
          <h3 class="text-[clamp(1.75rem,1.4rem+1.2vw,2.5rem)] leading-tight font-semibold tracking-[-0.03em] [font-stretch:110%]">
            <a
              href={lead.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-accent"
              aria-describedby="new-tab-hint"
            >
              {lead.title}
              <Icon name="arrow-up-right" class="size-5 text-ink-3" />
            </a>
          </h3>
          <p class="mt-2 text-[0.9375rem] text-ink">{lead.kind}</p>
          <p class="mt-1 text-sm text-ink-3">{lead.role} · <span class="tabular">{lead.year}</span></p>
          <p class="mt-4">{lead.description}</p>
          <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
            {lead.facts?.map((fact) => (
              <li class="fact">{fact}</li>
            ))}
          </ul>
          <ul class="stack mt-6">
            {lead.keywords?.slice(0, 5).map((k) => (
              <li>{k}</li>
            ))}
          </ul>
          <a
            href={lead.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link mt-6 inline-flex min-h-11 items-center gap-1.5 font-medium"
          >
            {host(lead.url)}
            <Icon name="arrow-up-right" class="size-4" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>

        {
          arch && (
            <figure class="arch reveal lg:col-span-7">
              <ol class="arch-flow" style={`--n: ${arch.layers.length}`}>
                {arch.layers.map((layer) => (
                  <li>{layer}</li>
                ))}
              </ol>
              <figcaption class="mt-5 max-w-[60ch] text-sm text-ink-3">
                How a request travels through {lead.title}.{arch.note && ` ${arch.note}`}
              </figcaption>
            </figure>
          )
        }
      </article>
    )
  }

  <div class="mt-20 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:mt-28 lg:grid-cols-3 [&>*]:min-w-0">
    {
      features.map((p) => {
        const Tag = p.url ? "a" : "div";
        return (
          <article id={projectAnchor(p.title ?? p.name)} class="scroll-mt-24">
            <Tag
              {...(p.url
                ? {
                    href: p.url,
                    target: "_blank",
                    rel: "noopener noreferrer",
                    tabindex: "-1",
                    "aria-hidden": "true",
                  }
                : {})}
              class="reveal-solid block rounded-2xl"
              data-frame
            >
              <div class="frame">
                <img
                  src={p.image}
                  alt={p.imageAlt ?? `${p.title} screenshot`}
                  width="900"
                  height="560"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </Tag>
            <div class="reveal">
            <h3 class="mt-6 text-h3 font-semibold tracking-[-0.015em]">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 hover:text-accent"
                  aria-describedby="new-tab-hint"
                >
                  {p.title}
                  <Icon name="arrow-up-right" class="size-4 text-ink-3" />
                </a>
              ) : (
                p.title
              )}
            </h3>
            <p class="mt-1 text-[0.9375rem] text-ink">{p.kind}</p>
            <p class="mt-0.5 text-sm text-ink-3">{p.role}</p>
            <ul class="mt-4 space-y-2">
              {p.facts?.map((fact) => (
                <li class="fact text-[0.9375rem]">{fact}</li>
              ))}
            </ul>
            <ul class="stack mt-4">
              {p.keywords?.slice(0, 5).map((k) => (
                <li>{k}</li>
              ))}
            </ul>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .fact {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ink-2);
  }
  .fact::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  /* Architecture strip: the layers a request crosses, as stops on one line.
     Stacked top to bottom on small screens, left to right from lg. The line
     runs from the first stop to the last; a short accent pulse travels it
     twice when the strip is revealed, and again while it is hovered. */
  .arch-flow {
    --dot: 0.4375rem;
    position: relative;
    display: grid;
    gap: 0.875rem;
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .arch-flow li {
    position: relative;
    padding-left: 1.5rem;
    text-wrap: balance;
  }
  .arch-flow li::before {
    content: "";
    position: absolute;
    z-index: 1;
    left: 0;
    top: calc(0.675em - var(--dot) / 2);
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    border: 1px solid var(--ink-3);
    background: var(--bg);
  }
  .arch-flow::before,
  .arch-flow::after {
    content: "";
    position: absolute;
    left: calc(var(--dot) / 2 - 0.5px);
    top: 0.675em;
    bottom: 0.675em;
    width: 1px;
  }
  .arch-flow::before {
    background: var(--line-strong);
  }
  .arch-flow::after {
    background: linear-gradient(to bottom, transparent, var(--accent), transparent) no-repeat 0 -40% / 100%
      28%;
    opacity: 0;
  }

  @media (min-width: 1024px) {
    .arch-flow {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 0;
    }
    .arch-flow li {
      padding: 1.125rem 1rem 0 0;
    }
    .arch-flow li::before {
      top: 0;
    }
    .arch-flow::before,
    .arch-flow::after {
      left: 0;
      right: calc(100% / var(--n) - var(--dot));
      top: calc(var(--dot) / 2 - 0.5px);
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .arch-flow::after {
      background: linear-gradient(to right, transparent, var(--accent), transparent) no-repeat -40% 0 / 28%
        100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .arch.is-in .arch-flow::after {
      animation: flow-y 2.4s cubic-bezier(0.45, 0, 0.55, 1) 0.5s 2;
    }
    .arch:hover .arch-flow::after {
      animation: flow-y 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
    @media (min-width: 1024px) {
      .arch.is-in .arch-flow::after {
        animation-name: flow-x;
      }
      .arch:hover .arch-flow::after {
        animation-name: flow-x;
      }
    }
  }
  @keyframes flow-y {
    0% {
      opacity: 0;
      background-position: 0 -40%;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: 0 140%;
    }
  }
  @keyframes flow-x {
    0% {
      opacity: 0;
      background-position: -40% 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: 140% 0;
    }
  }
</style>
