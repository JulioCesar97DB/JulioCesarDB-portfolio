---
// One stroke icon set (24px grid, 1.75 stroke) so every glyph shares weight.
// Brand marks (GitHub, LinkedIn) are filled, as their guidelines require.
type Name =
  | "arrow-up-right"
  | "arrow-down"
  | "chevron-down"
  | "copy"
  | "check"
  | "mail"
  | "file"
  | "sun"
  | "moon"
  | "monitor"
  | "github"
  | "linkedin";

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;

const strokes: Partial<Record<Name, string[]>> = {
  "arrow-up-right": ["M7 17 17 7", "M8 7h9v9"],
  "arrow-down": ["M12 5v14", "m6 13 6 6 6-6"],
  "chevron-down": ["m6 9 6 6 6-6"],
  copy: [
    "M9 9h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V10a1 1 0 0 1 1-1Z",
    "M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1",
  ],
  check: ["m5 12.5 4.5 4.5L19 7.5"],
  mail: ["M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Z", "m3.5 6.5 8.5 6.5 8.5-6.5"],
  file: ["M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z", "M14 3v5h5", "M9 13h6", "M9 17h4"],
  sun: [
    "M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z",
    "M12 2.5v2",
    "M12 19.5v2",
    "m5.28 5.28 1.41 1.41",
    "m17.31 17.31 1.41 1.41",
    "M2.5 12h2",
    "M19.5 12h2",
    "m5.28 18.72 1.41-1.41",
    "m17.31 6.69 1.41-1.41",
  ],
  moon: ["M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"],
  monitor: ["M4 4.5h16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5.5a1 1 0 0 1 1-1Z", "M8.5 20h7", "M12 16v4"],
};

const fills: Partial<Record<Name, string>> = {
  github:
    "M12 .3a12 12 0 0 0-3.8 23.38c.6.12.82-.26.82-.57v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3",
  linkedin:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z",
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  class:list={["shrink-0", className]}
  fill={fills[name] ? "currentColor" : "none"}
  stroke={fills[name] ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {fills[name] ? <path d={fills[name]} /> : strokes[name]?.map((d) => <path d={d} />)}
</svg>
