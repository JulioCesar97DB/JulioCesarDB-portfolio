---
// Technology marks for the Skills section. One colour (currentColor), one
// size per context, so a row of them reads as a set and not as a logo wall.
// Paths come from simple-icons at build time; nothing ships to the client
// but the inline SVG. A name without a mark renders nothing.
//
// Two things keep the marks light, since together they are the largest part
// of the page's HTML. Each path is rounded to the precision a 16-20px mark
// can show. And a mark that appears more than once on a page is written once,
// as a <symbol>; every later use points at it.
import { optimize } from "svgo";
import {
  siAstro,
  siClaude,
  siClaudecode,
  siCss,
  siDjango,
  siDocker,
  siExpo,
  siExpress,
  siFastapi,
  siGit,
  siGooglecloud,
  siGraphql,
  siHtml5,
  siJavascript,
  siJest,
  siModelcontextprotocol,
  siMongodb,
  siNextdotjs,
  siNodedotjs,
  siPostgresql,
  siPython,
  siRailway,
  siReact,
  siReactquery,
  siRedux,
  siShadcnui,
  siStripe,
  siSupabase,
  siTailwindcss,
  siTestinglibrary,
  siTypescript,
} from "simple-icons";
import { extraMarks } from "@/icons/tech-extra";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;

const simple: Record<string, { slug: string; path: string }> = {
  React: siReact,
  "React Native": siReact,
  "Next.js": siNextdotjs,
  Astro: siAstro,
  TypeScript: siTypescript,
  JavaScript: siJavascript,
  FastAPI: siFastapi,
  PostgreSQL: siPostgresql,
  Expo: siExpo,
  "Tailwind CSS": siTailwindcss,
  "shadcn/ui": siShadcnui,
  "HTML & CSS": siHtml5,
  CSS: siCss,
  "TanStack Query": siReactquery,
  Redux: siRedux,
  Python: siPython,
  "Node.js": siNodedotjs,
  "Express.js": siExpress,
  Django: siDjango,
  Supabase: siSupabase,
  MongoDB: siMongodb,
  GraphQL: siGraphql,
  Docker: siDocker,
  GCP: siGooglecloud,
  Railway: siRailway,
  Stripe: siStripe,
  "Git & GitHub": siGit,
  Jest: siJest,
  "React Testing Library": siTestinglibrary,
  Claude: siClaude,
  "Claude Code": siClaudecode,
  "MCP servers": siModelcontextprotocol,
};

// Products that carry their platform's mark.
const aliases: Record<string, string> = { "Azure AD": "Azure" };

// Not brands: drawn in the site's own stroke style.
const drawn: Record<string, string[]> = {
  "Skills & plugins": ["M12 22v-5", "M9 8V2", "M15 8V2", "M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"],
  "CI/CD": ["M4 12a8 8 0 0 1 13.66-5.66L20 8.5", "M20 4v4.5h-4.5", "M20 12a8 8 0 0 1-13.66 5.66L4 15.5", "M4 20v-4.5h4.5"],
};

const source = simple[name]
  ? { id: simple[name].slug, viewBox: "0 0 24 24", path: simple[name].path }
  : extraMarks[aliases[name] ?? name]
    ? { id: (aliases[name] ?? name).toLowerCase().replace(/[^a-z0-9]+/g, "-"), ...extraMarks[aliases[name] ?? name] }
    : null;
const strokes = drawn[name];

/** A tenth of a unit on the 24 grid is 0.08px at the largest size the marks
    are drawn; the 128 grid needs no decimals at all. */
function slim(viewBox: string, path: string) {
  const floatPrecision = viewBox === "0 0 24 24" ? 1 : 0;
  const { data } = optimize(`<svg viewBox="${viewBox}"><path d="${path}"/></svg>`, {
    plugins: [{ name: "convertPathData", params: { floatPrecision } }],
  });
  return data.match(/ d="([^"]*)"/)?.[1] ?? path;
}

// The marks already written on this page, kept on the request so each page
// render starts empty.
const written = (Astro.locals.techMarks ??= new Set<string>());
const symbolId = source ? `mark-${source.id}` : "";
const first = source ? !written.has(symbolId) : false;
if (source) written.add(symbolId);
---

{
  source ? (
    <svg class:list={["flex-none", className]} fill="currentColor" aria-hidden="true">
      {first && (
        <symbol id={symbolId} viewBox={source.viewBox}>
          <path d={slim(source.viewBox, source.path)} />
        </symbol>
      )}
      <use href={`#${symbolId}`} />
    </svg>
  ) : strokes ? (
    <svg
      viewBox="0 0 24 24"
      class:list={["flex-none", className]}
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {strokes.map((d) => (
        <path d={d} />
      ))}
    </svg>
  ) : null
}
